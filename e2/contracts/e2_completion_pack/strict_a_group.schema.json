{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E2 A-group strict contract pack",
  "description": "A 组补充版目标契约。只覆盖 FULL_CHECK 和 INCREMENTAL_CHECK。",
  "type": "object",
  "definitions": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "object",
      "required": ["url", "commit"],
      "properties": {
        "url": { "type": "string" },
        "commit": { "$ref": "#/definitions/sha40" }
      }
    },
    "build": {
      "type": "object",
      "required": ["command", "project_root"],
      "properties": {
        "command": { "type": "string" },
        "project_root": { "type": "string" }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["commit", "configuration_id", "actual_graph_uri"],
      "properties": {
        "commit": { "$ref": "#/definitions/sha40" },
        "configuration_id": { "type": "string" },
        "actual_graph_uri": {
          "type": "string",
          "pattern": "^artifact://"
        },
        "producer_job_id": {
          "type": "string",
          "pattern": "^job-[a-z0-9]+$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "type", "uri", "media_type", "producer_job_id", "sha256"],
      "properties": {
        "artifact_id": { "type": "string" },
        "type": {
          "enum": ["ACTUAL_GRAPH", "DECLARED_GRAPH", "ERROR_REPORT", "BUILD_LOG"]
        },
        "uri": {
          "type": "string",
          "pattern": "^artifact://pair[0-9]+/job-[a-z0-9]+/.+"
        },
        "media_type": { "type": "string" },
        "producer_job_id": {
          "type": "string",
          "pattern": "^job-[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_commit": { "$ref": "#/definitions/sha40" },
        "configuration_id": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "type", "target", "dependency", "commit", "detector", "location"],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F-[0-9]{4}$"
        },
        "type": { "enum": ["MISSING", "REDUNDANT"] },
        "target": { "type": "string" },
        "dependency": { "type": "string" },
        "commit": { "$ref": "#/definitions/sha40" },
        "detector": { "enum": ["BUILDCHECKER", "ECHECKER", "INSTRUCTOR_ORACLE"] },
        "delta_status": { "enum": ["NEW", "UNCHANGED", "ELIMINATED"] },
        "location": {
          "type": "object",
          "required": ["file", "kind"],
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "kind": {
              "enum": ["INCLUDE", "MAKEFILE_PREREQ", "LINK_FLAG", "MANUAL", "GENERATED_FILE"]
            },
            "makefile_target": { "type": "string" },
            "snippet": { "type": "string" }
          }
        },
        "evidence_uri": { "type": "string", "pattern": "^artifact://" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["SCHEMA_1001", "BASELINE_2001", "BASELINE_2002", "ENV_3001", "ENV_3003", "EXEC_4001", "EXEC_4002", "ANALYSIS_5001", "NOT_FOUND_6001", "CONFLICT_7001"]
        },
        "message": { "type": "string" },
        "detail": { "type": "object" }
      }
    },
    "jobEnvelope": {
      "type": "object",
      "required": ["schema_version", "job_id", "job_type", "status", "trace_id"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "job_id": {
          "type": "string",
          "pattern": "^job-[a-z0-9]+$"
        },
        "job_type": { "enum": ["FULL_CHECK", "INCREMENTAL_CHECK"] },
        "status": {
          "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED"]
        },
        "trace_id": {
          "type": "string",
          "pattern": "^trace-[a-z0-9]+$"
        },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "error": { "$ref": "#/definitions/error" }
      }
    }
  },
  "properties": {
    "full_check_request": {
      "type": "object",
      "required": ["job_type", "input"],
      "properties": {
        "job_type": { "const": "FULL_CHECK" },
        "input": {
          "type": "object",
          "required": ["repository", "build", "configuration_id"],
          "properties": {
            "repository": { "$ref": "#/definitions/repository" },
            "build": { "$ref": "#/definitions/build" },
            "configuration_id": { "type": "string" }
          }
        }
      }
    },
    "incremental_check_request": {
      "type": "object",
      "required": ["job_type", "input"],
      "properties": {
        "job_type": { "const": "INCREMENTAL_CHECK" },
        "input": {
          "type": "object",
          "required": ["repository", "baseline", "build"],
          "properties": {
            "repository": { "$ref": "#/definitions/repository" },
            "baseline": { "$ref": "#/definitions/baseline" },
            "build": { "$ref": "#/definitions/build" }
          }
        }
      }
    }
  }
}

